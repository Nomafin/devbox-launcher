[Unit]
Description=Start the scheduled agent runs that are due

[Service]
Type=oneshot
# A run may start the agents' tmux server, which then lands in this unit's
# cgroup. With the default KillMode=control-group, systemd would kill it, and
# every agent, as soon as the tick exits. Only ever signal the tick itself;
# the server stays behind in the cgroup, which systemd notes and leaves alone.
KillMode=process
ExecStart=@VENV@/bin/agentctl schedule tick
Environment=LAUNCHER_BASE_DIR=@BASE_DIR@
Environment=PATH=@CLAUDE_BIN_DIR@:/usr/local/bin:/usr/bin:/bin
# A few agents settle a few seconds each; a tick that hangs must not block
# the next one for good.
TimeoutStartSec=10min
